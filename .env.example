# =============================================================================
# Controller VM (bot-vm) Configuration — used by mc-bot
# =============================================================================

# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your-discord-bot-token

# Optional: Discord Server (Guild) ID for instant slash command registration.
# Leave blank to register slash commands globally (can take up to 1 hour).
DISCORD_GUILD_ID=

# Required: Channel ID for VM boot, ephemeral IP announcements, and shutdown alerts
DISCORD_ANNOUNCE_CHANNEL_ID=123456789012345678

# Optional: Channel ID for live two-way Minecraft <-> Discord chat & game events.
# Can be set to the same ID as DISCORD_ANNOUNCE_CHANNEL_ID, or left blank to disable live chat bridge.
DISCORD_CHAT_CHANNEL_ID=123456789012345678

# Google Cloud Compute Engine target Minecraft VM
GCP_PROJECT=my-gcp-project
GCP_ZONE=us-central1-a
MC_INSTANCE_NAME=mc-vm

# Minecraft Java Edition ports & RCON secret (must match server.properties on mc-vm)
MC_PORT=25565
MC_RCON_PORT=25575
MC_RCON_PASSWORD=change-me-strong-rcon-password

# Internal VPC webhook receiver (receives events from mc-agent on mc-vm)
WEBHOOK_LISTEN_ADDR=:8080
WEBHOOK_SECRET=change-me-shared-webhook-secret

# Auto-shutdown & polling timers (Go duration syntax: e.g. 15m, 60s)
# Defaults are tuned for modded Minecraft (longer boot + world flush times).
# Set IDLE_TIMEOUT=0 to disable idle auto-shutdown.
STARTUP_GRACE_PERIOD=15m
IDLE_TIMEOUT=15m
IDLE_WARNING_BEFORE=2m
POLL_INTERVAL=60s
BOOT_POLL_INTERVAL=3s
BOOT_TIMEOUT=3m
RCON_STOP_TIMEOUT=60s

# =============================================================================
# Minecraft VM (mc-vm) Configuration — used by mc-agent
# =============================================================================

# Path to the Minecraft Java Edition latest.log file on mc-vm
MC_LOG_PATH=/opt/minecraft/logs/latest.log

# Internal VPC URL of mc-bot using GCE internal DNS (no static IP required)
BOT_WEBHOOK_URL=http://bot-vm.c.my-gcp-project.internal:8080/events

# Must match WEBHOOK_SECRET configured on bot-vm
# WEBHOOK_SECRET=change-me-shared-webhook-secret

# Optional tuning for mc-agent
AGENT_POLL_INTERVAL=250ms
AGENT_SEND_BOOT_EVENT=true
